<?xml version="1.0" ?>
<boinc>
    <config>
        <!-- make_project's own bootstrap set this to the lowercase project
             identifier ("camicia", from the make_project ... camicia
             invocation) and it was never overridden since. It's not just
             cosmetic: config.long_name is embedded directly in every
             scheduler reply (sched_types.cpp's project_name element,
             which BOINC Manager reads) and in client-facing help text
             (sched_locality.cpp's "To get more %s work..." message), so
             every attached client was seeing "camicia" lowercase in real
             UI text while the rest of the site says "Camicia". -->
        <long_name>Camicia</long_name>
        <min_sendwork_interval>6</min_sendwork_interval>
        <max_wus_to_send>50</max_wus_to_send>
        <!-- Per-CPU cap on in-progress workunits: a host can hold at most
             max_wus_in_progress * (# of its CPUs) unfinished results at once.
             min_sendwork_interval/max_wus_to_send only throttle a single
             request; this bounds a host's total outstanding share of the
             backlog across many requests. -->
        <max_wus_in_progress>2</max_wus_in_progress>
        <daily_result_quota>500</daily_result_quota>
        <!-- Profile pictures/text aren't shown to other users until an
             admin approves them (camicia_ops/profile_screen_form.php).
             Turned on 2026-09-01 after finding update_uotd.php's daily
             cron task had been emailing UOTD_ADMIN_EMAIL every single day
             since the crontab fix, forever, since verification never gets
             set to 1 with no admin approval step happening; this alone
             doesn't fix that (still needs a first screening pass once
             real profiles exist), but is the actual feature this project
             is supposed to gate on. -->
        <profile_screening>1</profile_screening>
        <disable_account_creation>0</disable_account_creation>
        <disable_account_creation_rpc>0</disable_account_creation_rpc>
        <account_creation_rpc_require_consent>1</account_creation_rpc_require_consent>
        <disable_web_account_creation>0</disable_web_account_creation>
        <enable_login_mustagree_termsofuse>1</enable_login_mustagree_termsofuse>
        <enable_privacy_by_default>0</enable_privacy_by_default>
        <show_results>1</show_results>
        <cache_md5_info>1</cache_md5_info>
        <sched_debug_level>3</sched_debug_level>
        <fuh_debug_level>3</fuh_debug_level>
        <one_result_per_user_per_wu>0</one_result_per_user_per_wu>
        <send_result_abort>1</send_result_abort>
        <!-- Upload authenticity: with both at 0 (BOINC's own default),
             transitioner signs each result's upload target with
             keys/upload_private (already read unconditionally at
             transitioner startup; see file_upload_handler.cpp/
             process_result_template.cpp for the full mechanism), and
             file_upload_handler.cpp requires and verifies that signature
             plus enforces the signed max_nbytes before accepting an
             upload. Previously both were set to 1, disabling all of that
             with no recorded justification: any anonymous HTTP client
             could upload a file claiming to be the result for any
             workunit, with no proof it was the host actually assigned
             that work, and no enforced size limit. keys/upload_public is
             already permissioned for this (fix_permissions.sh's existing
             `*_public` chmod), so no other file needs to change. -->
        <dont_generate_upload_certificates>0</dont_generate_upload_certificates>
        <ignore_upload_certificates>0</ignore_upload_certificates>
        <!-- antique_file_deleter (sched/antique_file_deleter.cpp) reads this
             to find the upload-directory files' expected owner UID; it
             defaults to "apache" when unset, which doesn't exist on this
             Debian-based image (Apache runs as www-data here), causing
             "Couldn't find http_user 'apache' in passwd" on every single
             run since the crontab fix made tasks actually execute. -->
        <httpd_user>www-data</httpd_user>
        <!-- 2 = DELETE_ACCOUNT_METHOD_WIPE: fully deletes the account and all
             related DB records. BOINC's own delete_account.inc comment says
             "this is way too complex, just use the wipe option", so it is
             deliberately not method 3: that would call project_delete_account()
             in project.inc, which is an unimplemented stub that just die()s. -->
        <enable_delete_account>2</enable_delete_account>
    </config>
    <tasks>
        <task>
            <period>24 hours</period>
            <output>antique_file_deleter.out</output>
            <cmd>antique_file_deleter -d 2</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>db_dump.out</output>
            <cmd>db_dump -d 2 --dump_spec ../db_dump_spec.xml</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>db_purge.out</output>
            <!-- one_pass: run once and exit, matching this task's cron
                 triggered invocation, instead of db_purge's default
                 long running sleep 300s between scans daemon behavior.
                 min_age_days 7: leave a debugging buffer between a WU
                 becoming eligible (file_delete_state equals
                 FILE_DELETE_DONE) and actually purging its DB rows.
                 gzip: archive purged workunit/result rows to compressed
                 XML under archives/ before deleting, rather than skipping
                 archiving entirely; the game data itself is already
                 preserved forever in results/results.txt via
                 rotate_results.sh, but this keeps the DB row metadata
                 too, cheaply. -->
            <cmd>db_purge -d 2 --one_pass --min_age_days 7 --gzip</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>db_backup.out</output>
            <cmd>db_backup.sh</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>disk_space_check.out</output>
            <cmd>disk_space_check.sh</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>memory_check.out</output>
            <cmd>memory_check.sh</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>rotate_results.out</output>
            <cmd>rotate_results.sh</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>rotate_daemon_logs.out</output>
            <cmd>rotate_daemon_logs.sh</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>backup_offsite_gdrive.out</output>
            <cmd>backup_offsite_gdrive.sh</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>backup_usb.out</output>
            <cmd>backup_usb.sh</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>1 days</period>
            <output>update_uotd.out</output>
            <cmd>run_in_ops ./update_uotd.php</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>1 hour</period>
            <output>update_forum_activities.out</output>
            <cmd>run_in_ops ./update_forum_activities.php</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>1 days</period>
            <output>update_stats.out</output>
            <cmd>update_stats</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>update_profile_pages.out</output>
            <cmd>run_in_ops ./update_profile_pages.php</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <!-- Deliberately disabled, not a placeholder. Stock BOINC's
                 cross-project team sync: fetches boinc.berkeley.edu's
                 official "BOINC-wide teams" list and, for every team not
                 already present, creates a local instance AND a real
                 placeholder user account for that team's founder (their
                 actual name/email from the original project, a random
                 password), then emails them saying an instance of their
                 team was created here; see html/ops/team_import.php's
                 own header comment for the fixed crash bug found in this
                 one real run. That means real strangers get real accounts
                 and a real email from a project they never asked to join;
                 decided 2026-09-01 to keep this off until the actual
                 camicia.dev launch, when it's a real decision to revisit,
                 not something to re-enable out of momentum. -->
            <period>24 hours</period>
            <output>team_import.out</output>
            <cmd>run_in_ops ./team_import.php</cmd>
            <disabled>1</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>notify.out</output>
            <cmd>run_in_ops ./notify.php</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>badge_assign.out</output>
            <cmd>run_in_ops ./badge_assign.php</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <!-- Feeds html/user/progress_stats.json for the public
                 progress page (html/user/progress.php). 15 min: frequent
                 enough to feel alive, rare enough to keep the aggregate
                 queries it runs trivial; see that script's own header
                 comment for the full design rationale (no per-visitor DB
                 query, no real-time infra). -->
            <period>15 min</period>
            <output>generate_progress_stats.out</output>
            <cmd>run_in_ops ./generate_progress_stats.php</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>autolock.out</output>
            <cmd>run_in_ops ./autolock.php --ndays 90</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>delete_expired_tokens.out</output>
            <cmd>run_in_ops ./delete_expired_tokens.php</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>delete_expired_users_and_hosts.out</output>
            <cmd>run_in_ops ./delete_expired_users_and_hosts.php</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <!-- Catches a daemon dying between deploys (deploy.yml only
                 health-checks once, right after a deploy). Tries bin/start
                 to bring it back, notifies either way; see
                 daemon_health_check.sh's own header comment. -->
            <period>1 hour</period>
            <output>daemon_health_check.out</output>
            <cmd>daemon_health_check.sh</cmd>
            <disabled>0</disabled>
        </task>
    </tasks>
    <daemons>
        <daemon>
            <cmd>assimilator --app simulator -d 3</cmd>
        </daemon>
        <daemon>
            <cmd>sample_bitwise_validator -app simulator -d 3</cmd>
        </daemon>
        <daemon>
            <cmd>work_generator --app simulator --range_size 1000000000 --cushion 20 -d 3</cmd>
        </daemon>
        <daemon>
            <cmd>feeder -d 3 </cmd>
        </daemon>
        <daemon>
            <cmd>transitioner -d 3 </cmd>
        </daemon>
        <daemon>
            <cmd>file_deleter -d 3 </cmd>
        </daemon>
    </daemons>
</boinc>
