<?xml version="1.0" ?>
<boinc>
    <config>
        <min_sendwork_interval>6</min_sendwork_interval>
        <max_wus_to_send>50</max_wus_to_send>
        <!-- Per-CPU cap on in-progress workunits: a host can hold at most
             max_wus_in_progress * (# of its CPUs) unfinished results at once.
             min_sendwork_interval/max_wus_to_send only throttle a single
             request; this bounds a host's total outstanding share of the
             backlog across many requests. -->
        <max_wus_in_progress>2</max_wus_in_progress>
        <daily_result_quota>500</daily_result_quota>
        <disable_account_creation>0</disable_account_creation>
        <disable_account_creation_rpc>0</disable_account_creation_rpc>
        <account_creation_rpc_require_consent>1</account_creation_rpc_require_consent>
        <disable_web_account_creation>0</disable_web_account_creation>
        <enable_login_mustagree_termsofuse>1</enable_login_mustagree_termsofuse>
        <enable_privacy_by_default>0</enable_privacy_by_default>
        <show_results>1</show_results>
        <cache_md5_info>1</cache_md5_info>
        <sched_debug_level>3</sched_debug_level>
        <fuh_debug_level>3</fuh_debug_level>
        <one_result_per_user_per_wu>0</one_result_per_user_per_wu>
        <send_result_abort>1</send_result_abort>
        <dont_generate_upload_certificates>1</dont_generate_upload_certificates>
        <ignore_upload_certificates>1</ignore_upload_certificates>
        <!-- antique_file_deleter (sched/antique_file_deleter.cpp) reads this
             to find the upload-directory files' expected owner UID; it
             defaults to "apache" when unset, which doesn't exist on this
             Debian-based image (Apache runs as www-data here), causing
             "Couldn't find http_user 'apache' in passwd" on every single
             run since the crontab fix made tasks actually execute. -->
        <httpd_user>www-data</httpd_user>
        <!-- 2 = DELETE_ACCOUNT_METHOD_WIPE: fully deletes the account and all
             related DB records. BOINC's own delete_account.inc comment says
             "this is way too complex, just use the wipe option", so it is
             deliberately not method 3: that would call project_delete_account()
             in project.inc, which is an unimplemented stub that just die()s. -->
        <enable_delete_account>2</enable_delete_account>
    </config>
    <tasks>
        <task>
            <period>24 hours</period>
            <output>antique_file_deleter.out</output>
            <cmd>antique_file_deleter -d 2</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>db_dump.out</output>
            <cmd>db_dump -d 2 --dump_spec ../db_dump_spec.xml</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>db_purge.out</output>
            <!-- one_pass: run once and exit, matching this task's cron
                 triggered invocation, instead of db_purge's default
                 long running sleep 300s between scans daemon behavior.
                 min_age_days 7: leave a debugging buffer between a WU
                 becoming eligible (file_delete_state equals
                 FILE_DELETE_DONE) and actually purging its DB rows.
                 gzip: archive purged workunit/result rows to compressed
                 XML under archives/ before deleting, rather than skipping
                 archiving entirely; the game data itself is already
                 preserved forever in results/results.txt via
                 rotate_results.sh, but this keeps the DB row metadata
                 too, cheaply. -->
            <cmd>db_purge -d 2 --one_pass --min_age_days 7 --gzip</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>db_backup.out</output>
            <cmd>db_backup.sh</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>disk_space_check.out</output>
            <cmd>disk_space_check.sh</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>memory_check.out</output>
            <cmd>memory_check.sh</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>rotate_results.out</output>
            <cmd>rotate_results.sh</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>rotate_daemon_logs.out</output>
            <cmd>rotate_daemon_logs.sh</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>backup_offsite_gdrive.out</output>
            <cmd>backup_offsite_gdrive.sh</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>backup_usb.out</output>
            <cmd>backup_usb.sh</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>1 days</period>
            <output>update_uotd.out</output>
            <cmd>run_in_ops ./update_uotd.php</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>1 hour</period>
            <output>update_forum_activities.out</output>
            <cmd>run_in_ops ./update_forum_activities.php</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>1 days</period>
            <output>update_stats.out</output>
            <cmd>update_stats</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>update_profile_pages.out</output>
            <cmd>run_in_ops ./update_profile_pages.php</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>team_import.out</output>
            <cmd>run_in_ops ./team_import.php</cmd>
            <disabled>1</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>notify.out</output>
            <cmd>run_in_ops ./notify.php</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>badge_assign.out</output>
            <cmd>run_in_ops ./badge_assign.php</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>autolock.out</output>
            <cmd>run_in_ops ./autolock.php --ndays 90</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>delete_expired_tokens.out</output>
            <cmd>run_in_ops ./delete_expired_tokens.php</cmd>
            <disabled>0</disabled>
        </task>
        <task>
            <period>24 hours</period>
            <output>delete_expired_users_and_hosts.out</output>
            <cmd>run_in_ops ./delete_expired_users_and_hosts.php</cmd>
            <disabled>0</disabled>
        </task>
    </tasks>
    <daemons>
        <daemon>
            <cmd>assimilator --app simulator -d 3</cmd>
        </daemon>
        <daemon>
            <cmd>sample_bitwise_validator -app simulator -d 3</cmd>
        </daemon>
        <daemon>
            <cmd>work_generator --app simulator --range_size 1000000000 --cushion 20 -d 3</cmd>
        </daemon>
        <daemon>
            <cmd>feeder -d 3 </cmd>
        </daemon>
        <daemon>
            <cmd>transitioner -d 3 </cmd>
        </daemon>
        <daemon>
            <cmd>file_deleter -d 3 </cmd>
        </daemon>
    </daemons>
</boinc>
