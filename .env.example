DOMAIN=
PROJECTS_USER=

MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=
MARIADB_USER=
MARIADB_PASSWORD=

OPS_USER=
OPS_PASS=

SERVER_CONTAINER_NAME=
SERVER_HOSTNAME=
SERVER_PORTS=

SERVER_VOLUME_PROJECTS=
SERVER_VOLUME_PROJECTS_DIR=
SERVER_VOLUME_KEYS=
SERVER_VOLUME_KEYS_DIR=

# Optional: second local backup copy (tools/backup_usb.sh), a physically
# separate drive mirroring keys/db_backups/results -- distinct from the
# Google Drive offsite backup (RCLONE_CONFIG_PASS below), and from
# SERVER_VOLUME_PROJECTS/KEYS above. Leave both blank on local dev; the
# volume mount in docker-compose.yml falls back to a harmless /tmp stub
# path so nothing breaks without this set. On production, point
# BACKUP_DRIVE at the mounted drive's host path (e.g. /mnt/backup1tb) --
# BACKUP_DRIVE_DIR only needs to differ if you want a different in-container
# path than the host path.
BACKUP_DRIVE=
BACKUP_DRIVE_DIR=

DATABASE_CONTAINER_NAME=
DATABASE_VOLUME=
DATABASE_NETWORK=

# Optional: only needed to run the cloudflared service
# (docker compose --profile cloudflare up -d). See DEPLOYMENT.md.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: disk_space_check.sh/memory_check.sh push a ntfy.sh alert here
# when they cross a warning/critical threshold. Generate a random,
# unguessable topic name (e.g. `openssl rand -hex 16`) -- anyone who knows
# it can read/post to it, since ntfy.sh topics aren't access-controlled by
# default. Leave blank to skip notifications (checks still log locally).
# See DEPLOYMENT.md.
NTFY_TOPIC=

# Optional: Akismet API key for BOINC's forum-post/reply/PM/profile
# spam-content filtering (html/inc/akismet.inc) -- separate from, and not
# replaced by, the always-on StopForumSpam check at account-creation time
# (USE_STOPFORUMSPAM in project.inc). Get a free key at akismet.com
# (Personal plan, non-commercial use); see akismet.inc's own header
# comment for setup details. Injected into config.xml's <akismet_key>
# element at deploy time. Leave blank to skip -- forum/PM/profile content
# simply won't be spam-filtered.
AKISMET_KEY=

# Optional: HMAC secret for the verification code printed on
# html/user/cert1.php certificates (proves a downloaded/printed
# certificate was actually issued by this project, without any database
# lookup at verification time -- see cert.inc's cert_verify_code()).
# Generate with `openssl rand -hex 32`. Leave blank to skip -- cert1.php
# simply won't print a code or verification link in that case.
CERT_VERIFY_SECRET=

# Optional: passphrase to decrypt keys/code_sign_private.gpg during
# tools.sh's update_versions step (per BOINC's own code-signing wiki
# guidance -- keep the key encrypted at rest, decrypt only briefly when
# actually signing a new app version). Leave blank to skip -- a plaintext
# code_sign_private must already exist in that case, or update_versions
# fails with BOINC's own "no code signing private key" error.
#
# IMPORTANT: this is deliberately NOT how production gets its value.
# Production's passphrase lives only as a GitHub Actions `production`
# Environment secret of the same name, injected by deploy.yml -- it is
# never written to production's .env. This local entry is for local-dev
# convenience only; use a different passphrase than production's (a box
# compromise shouldn't also expose whatever else that passphrase protects).
CODE_SIGN_KEY_PASSPHRASE=

# Optional: outbound SMTP for account-deletion confirmations, password
# resets, and forum notifications (project.inc's make_php_mailer()). Leave
# SMTP_HOST blank to skip -- mail silently no-ops (no local MTA) same as
# before this was configured. Recommended: Brevo's free tier (300 emails/day,
# no card required) -- sign up at brevo.com, then Settings > SMTP & API >
# SMTP tab for the host/login/key. See DEPLOYMENT.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Camicia

# Optional: reCAPTCHA v2 ("I'm not a robot" checkbox) for account creation,
# team creation, profile creation, and account-ownership recovery
# (html/inc/recaptchalib.inc). Register a site at
# google.com/recaptcha/admin -- pick v2 Checkbox, not v3 -- for every
# hostname real visitors will use (e.g. camicia.dev, and any staging
# hostname); "localhost" always works for local testing without being
# listed. Both keys must be set together or not at all: RECAPTCHA_SITE_KEY
# alone renders the widget but silently skips validating it (see tools.sh's
# injection step for why), which is worse than not having it at all. Leave
# both blank to skip -- account creation etc. simply won't show a captcha.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional: credit-based gates, off unless set. Values are in Cobblestones
# (BOINC's credit unit, 200 = one CPU sustaining 1 GFLOPS for 24 hours).
# The defaults below were derived from this project's own measured
# throughput (~165k indices/sec single-threaded, FPOPS_PER_DEAL=6.5e4 in
# work_generator.cpp) rather than guessed -- re-derive once real volunteer
# hosts (not synthetic test ones) have granted-credit history to check
# against, since no real host has completed a full-size workunit yet.
#
# PROFILE_MIN_CREDIT: stock BOINC's <profile_min_credit> config.xml
# element. Gates two things at once: creating/editing a profile
# (create_profile.php) and whether an anonymous visitor can see a
# low-credit user's profile at all (profile.inc). Leave blank to skip --
# no gate, matches stock behavior.
PROFILE_MIN_CREDIT=

# TEAM_CREATE_NEED_CREDIT: 1 to require total_credit>0 (i.e. at least one
# completed workunit) before a user can create a team -- stock BOINC's own
# TEAM_CREATE_NEED_CREDIT constant, just never defined by default. This one
# is boolean, not a threshold amount -- stock BOINC has no way to require a
# specific credit total for team creation, only "any at all". Leave blank
# or 0 to skip -- unrestricted, matches stock behavior.
TEAM_CREATE_NEED_CREDIT=
