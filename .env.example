DOMAIN=
PROJECTS_USER=

MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=
MARIADB_USER=
MARIADB_PASSWORD=

OPS_USER=
OPS_PASS=

SERVER_CONTAINER_NAME=
SERVER_HOSTNAME=
SERVER_PORTS=

SERVER_VOLUME_PROJECTS=
SERVER_VOLUME_PROJECTS_DIR=
SERVER_VOLUME_KEYS=
SERVER_VOLUME_KEYS_DIR=

DATABASE_CONTAINER_NAME=
DATABASE_VOLUME=
DATABASE_NETWORK=

# Optional: only needed to run the cloudflared service
# (docker compose --profile cloudflare up -d). See DEPLOYMENT.md.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: disk_space_check.sh/memory_check.sh push a ntfy.sh alert here
# when they cross a warning/critical threshold. Generate a random,
# unguessable topic name (e.g. `openssl rand -hex 16`) -- anyone who knows
# it can read/post to it, since ntfy.sh topics aren't access-controlled by
# default. Leave blank to skip notifications (checks still log locally).
# See DEPLOYMENT.md.
NTFY_TOPIC=

# Optional: Akismet API key for BOINC's forum-post/reply/PM/profile
# spam-content filtering (html/inc/akismet.inc) -- separate from, and not
# replaced by, the always-on StopForumSpam check at account-creation time
# (USE_STOPFORUMSPAM in project.inc). Get a free key at akismet.com
# (Personal plan, non-commercial use); see akismet.inc's own header
# comment for setup details. Injected into config.xml's <akismet_key>
# element at deploy time. Leave blank to skip -- forum/PM/profile content
# simply won't be spam-filtered.
AKISMET_KEY=