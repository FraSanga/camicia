DOMAIN=
PROJECTS_USER=

MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=
MARIADB_USER=
MARIADB_PASSWORD=

OPS_USER=
OPS_PASS=

SERVER_CONTAINER_NAME=
SERVER_HOSTNAME=
SERVER_PORTS=

SERVER_VOLUME_PROJECTS=
SERVER_VOLUME_PROJECTS_DIR=
SERVER_VOLUME_KEYS=
SERVER_VOLUME_KEYS_DIR=

DATABASE_CONTAINER_NAME=
DATABASE_VOLUME=
DATABASE_NETWORK=

# Optional: only needed to run the cloudflared service
# (docker compose --profile cloudflare up -d). See DEPLOYMENT.md.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: disk_space_check.sh/memory_check.sh push a ntfy.sh alert here
# when they cross a warning/critical threshold. Generate a random,
# unguessable topic name (e.g. `openssl rand -hex 16`) -- anyone who knows
# it can read/post to it, since ntfy.sh topics aren't access-controlled by
# default. Leave blank to skip notifications (checks still log locally).
# See DEPLOYMENT.md.
NTFY_TOPIC=

# Optional: outbound SMTP for account-deletion confirmations, password
# resets, and forum notifications (project.inc's make_php_mailer()). Leave
# SMTP_HOST blank to skip -- mail silently no-ops (no local MTA) same as
# before this was configured. Recommended: Brevo's free tier (300 emails/day,
# no card required) -- sign up at brevo.com, then Settings > SMTP & API >
# SMTP tab for the host/login/key. See DEPLOYMENT.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Camicia